{
  "name": "hame-relay",
  "version": "1.2.0",
  "description": "MQTT message forwarder between brokers",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "npm run build && node --test --import tsx/esm",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt src"
  },
  "dependencies": {
    "mqtt": "^5.15.2",
    "node-fetch": "^3.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
