{
  "name": "hame-relay",
  "version": "1.2.0",
  "description": "MQTT message forwarder between brokers",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsrs",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "npm run build && node --test --import tsx/esm",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "lint": "oxlint src && oxfmt --check src",
    "lint:fix": "oxlint --fix src && oxfmt src"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "node-fetch": "^3.3.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rimraf": "^6.1.3",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "tsx": "^4.23.15"
  }
}
